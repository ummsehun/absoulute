{
  "appId": "com.example.diskvisualizer",
  "productName": "DiskVisualizer",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": [
        "scanner-macos",
        "scanner-win.exe",
        "scanner-linux",
        "helper-control-macos",
        "helper-xpc-enumerate-macos",
        "helper-enumerate-macos",
        "service-management-probe-macos",
        "diskviz-scanner",
        "diskviz-scanner.exe"
      ]
    }
  ],
  "mac": {
    "target": ["dmg"],
    "hardenedRuntime": true,
    "entitlements": "resources/entitlements/mac.plist",
    "entitlementsInherit": "resources/entitlements/mac.inherit.plist",
    "extraFiles": [
      {
        "from": "resources/helper/LaunchDaemons",
        "to": "Library/LaunchDaemons",
        "filter": [
          "com.example.diskvisualizer.privileged-helper.plist"
        ]
      },
      {
        "from": "resources/helper/LaunchServices",
        "to": "Library/LaunchServices",
        "filter": [
          "com.example.diskvisualizer.privileged-helper"
        ]
      }
    ]
  },
  "win": {
    "target": ["nsis"]
  },
  "linux": {
    "target": ["AppImage"]
  }
}
